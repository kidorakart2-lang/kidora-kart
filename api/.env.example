[TEMPLATE]
# ── API Server Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# ───────────────────────────────────────────────────────────────────────

# Server port (default: 5000)
PORT=5000

# JWT secret for signing access tokens (REQUIRED — generate a strong one)
JWT_SECRET=your-jwt-secret-here

# Node environment (development / production / test)
NODE_ENV=development

# MongoDB connection string (REQUIRED)
NEW_DB_URL=mongodb://localhost:27017/toyshop

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# The web frontend and admin panel URLs should be listed here.
# Default: http://localhost:3000,http://localhost:3001
#
# Examples:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:3001
#   CORS_ORIGINS=https://toyshop.com,https://admin.toyshop.com
#
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── URLs ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Email (Nodemailer) ───────────────────────────────────────────────
MY_GMAIL=your-email@gmail.com
MY_GMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=Toy Shop
APP_NAME=Toy Shop
SUPPORT_EMAIL=support@toyshop.com

# ── Cloudflare R2 (file uploads) ─────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
R2_API_TOKEN=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=
CDN_HOST=cdn.toyshop.com

# ── Razorpay (payments) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (alternative email provider) ──────────────────────────────
RESEND_API_KEY=



# ── Google OAuth (social login) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Provider Configuration ────────────────────────────────────────
# Select the AI provider: "gemini" (default) or "openrouter"
# Gemini requires GEMINI_API_KEY; OpenRouter requires OPENROUTER_API_KEY.
AI_PROVIDER=gemini

# ── Google Gemini AI ──────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OpenRouter AI ────────────────────────────────────────────────────
# OpenAI-compatible gateway with many free and paid models.
# Get your API key at: https://openrouter.ai/keys
# Use "openrouter/free" for free tier, or any model ID like "openai/gpt-4o".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── AI Daily Budget ──────────────────────────────────────────────────
AI_DAILY_TOKEN_BUDGET=100000

# ── Shiprocket (shipping / courier integration) ──────────────────────
# Required only if you use Shiprocket for order shipping and tracking.
#
# To get credentials:
#   1. Sign up / log in at https://app.shiprocket.in
#   2. Go to Settings → API → Create an API User (use a different email)
#   3. The API user email/password go here (NOT your main login)
#
# SHIPROCKET_TOKEN is optional — if provided, the API uses it directly.
# Otherwise the client authenticates with email/password on each restart
# and caches the JWT internally (auto-refreshes on 401).
#
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# SHIPROCKET_TOKEN=

# Shiprocket webhook — configure in Shiprocket Dashboard:
#   Settings → API → Webhooks tab
#   URL: POST https://your-api.com/api/website/shipping/webhook
#
# The webhook receives tracking status updates (Delivered, Cancelled, etc.)
# and automatically updates your order statuses.
#

# ── LocationIQ (checkout geolocation auto-fill) ──────────────────────
# Optional — enables "Detect Location" on the checkout page for guests.
# Free key from https://locationiq.com (Standard tier is fine).
# The key stays server-side; the browser only sends lat/lng.
#
LOCATIONIQ_API_KEY=

# ── Cache Revalidation (shared secret with web frontend) ─────────────
# This secret allows the API to trigger cache invalidation on the web
# frontend when data changes. It should match the REVALIDATE_SECRET
# in the web frontend's .env.local.
#
# Generate a strong random secret:
#   openssl rand -hex 32
#
REVALIDATE_SECRET=e-commerce
