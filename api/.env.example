[TEMPLATE]
# ── API Server Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# ───────────────────────────────────────────────────────────────────────

# Server port (default: 5000)
PORT=5000

# JWT secret for signing access tokens (REQUIRED — generate a strong one)
JWT_SECRET=your-jwt-secret-here

# Node environment (development / production / test)
NODE_ENV=development

# MongoDB connection string (REQUIRED)
NEW_DB_URL=mongodb://localhost:27017/toyshop

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# The web frontend and admin panel URLs should be listed here.
# Default: http://localhost:3000,http://localhost:3001
#
# Examples:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:3001
#   CORS_ORIGINS=https://toyshop.com,https://admin.toyshop.com
#
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── URLs ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Email (Nodemailer) ───────────────────────────────────────────────
MY_GMAIL=your-email@gmail.com
MY_GMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=Toy Shop
APP_NAME=Toy Shop
SUPPORT_EMAIL=support@toyshop.com

# ── Cloudflare R2 (file uploads) ─────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
R2_API_TOKEN=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=
CDN_HOST=cdn.toyshop.com

# ── Razorpay (payments) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (alternative email provider) ──────────────────────────────
RESEND_API_KEY=

# ── Twilio (SMS / phone verification) ────────────────────────────────
TWILLO_VERIFY_SERVICE_SID=
TWILLO_ACCOUNT_SID=
TWILLO_AUTH_TOKEN=

# ── Google OAuth (social login) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Gemini AI (AI helpers) ─────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_DAILY_TOKEN_BUDGET=100000

# ── Cache Revalidation (shared secret with web frontend) ─────────────
# This secret allows the API to trigger cache invalidation on the web
# frontend when data changes. It should match the REVALIDATE_SECRET
# in the web frontend's .env.local.
#
# Generate a strong random secret:
#   openssl rand -hex 32
#
REVALIDATE_SECRET=e-commerce
